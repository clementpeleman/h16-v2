# Copy to .env.local for development. On Coolify these are set on the service —
# note that every NEXT_PUBLIC_* value is inlined at BUILD time, so they must be
# available as build args, not only at runtime.

# Strapi (self-hosted, Coolify + Traefik).
# Use https://h16.strapi.peleman.io once that domain is attached to the Strapi
# service; until then it 503s and https://strapi.peleman.io is the live host.
NEXT_PUBLIC_STRAPI_URL=https://h16.strapi.peleman.io/api
NEXT_PUBLIC_STRAPI_ASSET_URL=https://h16.strapi.peleman.io

# Server-only read token. Deliberately NOT prefixed NEXT_PUBLIC_, so it never
# ships in the client bundle. Generate in Strapi under Settings > API Tokens
# (read-only is enough).
STRAPI_TOKEN=

# Absolute base for <link rel="canonical"> and og:url. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://h16.be
# Production (after the move): https://www.h16.be — www is the host the old
# site already redirects to and Google has indexed.

# Indexing is opt-in. Leave unset/false on h16.peleman.io; set to "true" only
# on the production h16.be deployment.
NEXT_PUBLIC_ALLOW_INDEXING=false

# SendGrid, for the contact form.
NEXT_PUBLIC_SG_API_KEY=
NEXT_PUBLIC_TO_EMAIL=info@h16.be
NEXT_PUBLIC_FROM_EMAIL=

# Umami (self-hosted on Coolify). Leave empty to ship no analytics script.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://stats.peleman.io/script.js
